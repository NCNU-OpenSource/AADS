# ============================================
# AI Auto Debug System - Environment Variables
# ============================================

# ============================================
# Prebuilt service images (docker-compose.prod.yaml)
# ============================================
# Where the 6 custom service images are pulled from. Built/pushed by
# .github/workflows/build-images.yml. Used only by docker-compose.prod.yaml.
AADS_IMAGE_REGISTRY=ghcr.io/bs10081
AADS_IMAGE_TAG=latest

# ============================================
# Layer 0: TimescaleDB 持久化存儲
# ============================================
TIMESCALEDB_PASSWORD=logdb_password_change_me
AADS_DB_MIGRATION_MODE=safe

# ============================================
# System Agent / On-Device RCA: LLM 配置 (OpenAI 相容 API)
# ============================================
# Agents talk to the in-stack LiteLLM proxy. Configure upstream here.
LITELLM_MASTER_KEY=sk-aads-dev
LITELLM_MODEL=gpt-5.5
AADS_LITELLM_UPSTREAM_API_BASE=https://api.openai.com/v1
AADS_LITELLM_UPSTREAM_API_KEY=sk-xxxxx

# 本地 Ollama (可選)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# LLM 策略: cascade | primary_only | local_only
LLM_STRATEGY=cascade

# ============================================
# Gate / 通知管道
# ============================================
# Slack Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxxx/xxxxx/xxxxx

# 自定義 Webhook URL (可選)
WEBHOOK_URL=

# 通知嚴重程度過濾器: low | medium | high | critical
SEVERITY_FILTER=medium

# 自動修復 (預設關閉以確保安全)
AUTO_REMEDIATION_ENABLED=false
AADS_ADMIN_API_KEY=change-me-admin-key
PI_AGENT_TOKEN=change-me-agent-token
AADS_ENV=test
AADS_NODE_ID=controller
AADS_DEFAULT_NODE_ID=target-ubuntu
AADS_NODE_ENVIRONMENT=test
AADS_FORCE_GATE_APPROVAL=false
EXECUTOR_POLL_INTERVAL=5
NODE_LOCK_TTL_SECONDS=120
AADS_IDEMPOTENCY_TTL_MINUTES=30
MIN_CLUSTER_SIZE=1
ENABLE_DIAGNOSIS_REUSE=false
ENABLE_KNOWLEDGE_BASE=false

# ============================================
# Layer 1: LogBERT 配置
# ============================================
ANOMALY_THRESHOLD=0.5
BATCH_SIZE=50
MAX_WAIT_SECONDS=2.0
ENABLE_PATTERN_FILTER=true
ENABLE_LOGBERT_FILTER=true
INITIAL_LOOKBACK_SECONDS=300
LAYER1_LOKI_QUERY={source="target-nginx"}
AADS_INSTALL_TARGET_ALLOY=true

# ============================================
# 其他配置
# ============================================
# Grafana Admin 密碼
GF_SECURITY_ADMIN_PASSWORD=admin
