# ============================================
# AI Auto Debug System - Environment Variables
# ============================================

# ============================================
# Layer 0: TimescaleDB 持久化存儲
# ============================================
TIMESCALEDB_PASSWORD=logdb_password_change_me

# ============================================
# Layer 2: LLM 配置 (OpenAI 相容 API)
# ============================================
# 主要 LLM (支援自定義 baseURL)
LLM_BASE_URL=https://api.openai.com/v1  # 可替換為 NEW API 或其他第三方 API
LLM_API_KEY=sk-xxxxx
LLM_MODEL=gpt-4o-mini

# 本地 Ollama (可選)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# LLM 策略: cascade | primary_only | local_only
LLM_STRATEGY=cascade

# ============================================
# Layer 3: 通知管道
# ============================================
# Slack Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxxx/xxxxx/xxxxx

# 自定義 Webhook URL (可選)
WEBHOOK_URL=

# 通知嚴重程度過濾器: low | medium | high | critical
SEVERITY_FILTER=medium

# 自動修復 (預設關閉以確保安全)
AUTO_REMEDIATION_ENABLED=false

# ============================================
# Layer 1: LogBERT 配置
# ============================================
ANOMALY_THRESHOLD=0.5
BATCH_SIZE=50
MAX_WAIT_SECONDS=2.0

# ============================================
# 其他配置
# ============================================
# Grafana Admin 密碼
GF_SECURITY_ADMIN_PASSWORD=admin
