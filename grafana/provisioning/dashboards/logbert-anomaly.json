      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              },
              {
                "value": 3,
                "color": "yellow"
              },
              {
                "value": 5,
                "color": "orange"
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "異常趨勢",
      "description": "每分鐘異常數量變化趨勢",
      "type": "timeseries",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(count_over_time({source=\"logbert\", type=\"anomaly\", container=~\"$container\", severity=~\"$severity\"}[1m]))",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "P2AEF7061FA4CF50C"
          },
          "legendFormat": "異常/分鐘"
