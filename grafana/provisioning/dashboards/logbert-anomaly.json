{
  "title": "LogBERT 異常檢測分析",
  "description": "基於 BERT 的 AI 日誌異常檢測 Dashboard - 分層結構設計，支援快速定位和深度調查",
  "tags": [
    "logbert",
    "anomaly",
    "ai",
    "sre"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 0,
  "refresh": "30s",
  "uid": "logbert-anomaly",
  "id": null,
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "容器",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "P2AEF7061FA4CF50C"
        },
        "query": "label_values({source=\"logbert\"}, container)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "severity",
        "label": "嚴重度",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "High",
            "value": "high"
          },
          {
            "selected": false,
            "text": "Medium",
            "value": "medium"
          }
        ],
        "query": "high,medium"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "異常總數",
      "description": "在選定時間範圍內檢測到的異常日誌總數",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "count_over_time({source=\"logbert\", type=\"anomaly\", container=~\"$container\", severity=~\"$severity\"}[$__range])",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "P2AEF7061FA4CF50C"
          }
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 10,
                "color": "yellow"
              },
              {
                "value": 50,
                "color": "orange"
              },
              {
                "value": 100,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "🔴 高危異常",
      "description": "異常分數 > 0.7 的高危險日誌數量",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "expr": "count_over_time({source=\"logbert\", type=\"anomaly\", severity=\"high\", container=~\"$container\"}[$__range])",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "P2AEF7061FA4CF50C"
          }
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "影響容器數",
      "description": "出現異常的不同容器數量",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(count by (container) (count_over_time({source=\"logbert\", type=\"anomaly\", container=~\"$container\", severity=~\"$severity\"}[$__range])))",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "P2AEF7061FA4CF50C"
          }
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name",
        "orientation": "auto"
