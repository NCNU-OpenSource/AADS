      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "auto",
            "lineInterpolation": "smooth"
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 5,
      "title": "容器異常分佈",
