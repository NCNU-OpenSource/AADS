{
  "title": "原始日誌查詢 - Docker 容器日誌",
  "description": "查看從 Docker 容器收集的原始日誌（Tenant: raw）",
  "tags": ["docker", "logs", "raw"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 0,
  "refresh": "10s",
  "uid": "raw-logs-dashboard",
  "id": null,
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "容器",
        "type": "query",
        "datasource": "Loki - Raw Logs",
        "query": "label_values({source=\"docker\"}, container)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Docker 容器日誌總數",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "count_over_time({source=\"docker\", container=~\"$container\"}[$__range])",
          "refId": "A",
          "datasource": "Loki - Raw Logs"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 1000, "color": "yellow"},
              {"value": 10000, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "活躍容器數量",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [
        {
          "expr": "count(count by (container) (count_over_time({source=\"docker\", container=~\"$container\"}[$__range])))",
          "refId": "A",
          "datasource": "Loki - Raw Logs"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "blue"},
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "title": "日誌速率（每分鐘）",
      "type": "timeseries",
      "gridPos": {"h": 4, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(rate({source=\"docker\", container=~\"$container\"}[1m])) * 60",
          "refId": "A",
          "datasource": "Loki - Raw Logs",
          "legendFormat": "日誌/分鐘"
        }
      ],
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 4,
      "title": "各容器日誌數量分佈",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {
          "expr": "topk(10, sum by (container) (count_over_time({source=\"docker\", container=~\"$container\"}[$__range])))",
          "refId": "A",
          "datasource": "Loki - Raw Logs"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "pieType": "pie",
        "displayLabels": ["percent"]
      }
    },
    {
      "id": 5,
      "title": "各容器日誌速率（Top 5）",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {
          "expr": "topk(5, sum by (container) (rate({source=\"docker\", container=~\"$container\"}[5m])))",
          "refId": "A",
          "datasource": "Loki - Raw Logs",
          "legendFormat": "{{container}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 6,
      "title": "Docker 容器日誌串流",
      "type": "logs",
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 12},
      "targets": [
        {
          "expr": "{source=\"docker\", container=~\"$container\"}",
          "refId": "A",
          "datasource": "Loki - Raw Logs"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      }
    }
  ],
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1
}
