#!/usr/bin/env bash
set -euo pipefail

SNAPSHOT_DIR="${AADS_MYSQL_SNAPSHOT_DIR:-/var/lib/aads-agent/snapshots/mysql}"

if [[ ! -f "$SNAPSHOT_DIR/my.cnf" ]]; then
  echo "blocked: no_snapshot" >&2
  exit 42
fi

MYSQL_CONF="$(find /etc/mysql -name "*.cnf" \
  \( -path "*/mysql.conf.d/*" -o -path "*/mariadb.conf.d/*" -o -name "my.cnf" \) \
  2>/dev/null | sort | head -1)"

if [[ -z "$MYSQL_CONF" ]]; then
  echo "blocked: mysql_config_not_found" >&2
  exit 42
fi

# Refresh only if config currently validates
if mysqld --validate-config >/dev/null 2>&1 || mariadbd --validate-config >/dev/null 2>&1 || [[ -s "$MYSQL_CONF" ]]; then
  cp -a "$MYSQL_CONF" "$SNAPSHOT_DIR/my.cnf"
  chown root:aads-agent "$SNAPSHOT_DIR/my.cnf"
  chmod 0640 "$SNAPSHOT_DIR/my.cnf"
  echo "snapshot_refreshed=true config_file=$MYSQL_CONF"
  exit 0
fi

echo "snapshot_refreshed=false existing_snapshot=true"
exit 0
