[Unit]
Description=AADS On-Device Agent
After=network-online.target nginx.service
Wants=network-online.target

[Service]
User=aads-agent
Group=aads-agent
EnvironmentFile=/etc/aads-agent/agent.env
WorkingDirectory=/opt/aads-agent
ExecStart=/bin/sh -c 'exec /opt/aads-agent/venv/bin/uvicorn main:app --host "${AADS_AGENT_HOST:-0.0.0.0}" --port "${AADS_AGENT_PORT:-8090}"'
Restart=on-failure
RestartSec=5
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/nginx -/etc/postgresql -/etc/redis -/etc/mysql /var/lib/aads-agent /var/log/nginx -/var/log/postgresql -/var/log/redis -/var/log/mysql /run /tmp
ReadOnlyPaths=-/var/lib/postgresql -/var/lib/redis -/var/lib/mysql

[Install]
WantedBy=multi-user.target
